<% content_for :title, "Create account · Nexus" %>

<h2 class="panel__title">Create your account</h2>

<%= form_with model: @user, url: registration_path do |f| %>
  <% if @user.errors.any? %>
    <div class="flash flash--alert" role="alert">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :display_name, "Full name", class: "field__label" %>
    <%= f.text_field :display_name, required: true, autofocus: true,
          autocomplete: "name", class: "input", placeholder: "Jane Smith" %>
  </div>

  <div class="field">
    <%= f.label :email_address, "Email address", class: "field__label" %>
    <%= f.email_field :email_address, required: true,
          autocomplete: "email", class: "input", placeholder: "you@arcline.it" %>
  </div>

  <div class="field">
    <%= f.label :password, "Password", class: "field__label" %>
    <%= f.password_field :password, required: true, minlength: User::MIN_PASSWORD_LENGTH,
          autocomplete: "new-password", class: "input", placeholder: "At least 8 characters" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirm password", class: "field__label" %>
    <%= f.password_field :password_confirmation, required: true, minlength: User::MIN_PASSWORD_LENGTH,
          autocomplete: "new-password", class: "input", placeholder: "Repeat your password" %>
  </div>

  <%= f.submit "Create account", class: "btn btn--primary btn--block" %>
<% end %>

<p class="text-muted" style="text-align:center;margin-top:1.5rem;">
  Already have an account? <%= link_to "Sign in", new_session_path %>
</p>
