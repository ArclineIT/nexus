<% content_for :title, "Sign in · Nexus" %>

<h2 class="panel__title">Sign in to your account</h2>

<%= form_with url: session_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :email_address, "Email address", class: "field__label" %>
    <%= f.email_field :email_address, required: true, autofocus: true,
          autocomplete: "email", class: "input", placeholder: "you@arcline.it" %>
  </div>

  <div class="field">
    <%= f.label :password, "Password", class: "field__label" %>
    <%= f.password_field :password, required: true, autocomplete: "current-password",
          class: "input", placeholder: "••••••••" %>
  </div>

  <div class="form-row">
    <label class="checkbox"><%= check_box_tag :remember %> Remember me</label>
    <%= link_to "Forgot password?", new_password_path %>
  </div>

  <%= f.submit "Sign in", class: "btn btn--primary btn--block" %>
<% end %>

<p class="text-muted" style="text-align:center;margin-top:1.5rem;">
  New to Nexus? <%= link_to "Create an account", new_registration_path %>
</p>
