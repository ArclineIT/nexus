<% content_for :title, "Reset password · Nexus" %>

<h2 class="panel__title">Reset your password</h2>
<p class="text-muted" style="margin-top:-0.5rem;margin-bottom:1.25rem;">
  Enter your email address and we'll send you a link to reset your password.
</p>

<%= form_with url: passwords_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :email_address, "Email address", class: "field__label" %>
    <%= f.email_field :email_address, required: true, autofocus: true,
          autocomplete: "email", class: "input", placeholder: "you@arcline.it" %>
  </div>

  <%= f.submit "Send reset link", class: "btn btn--primary btn--block" %>
<% end %>

<p class="text-muted" style="text-align:center;margin-top:1.5rem;">
  <%= link_to "Back to sign in", new_session_path %>
</p>
