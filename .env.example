# Nexus — environment configuration.
# Copy to .env for local development. See README.md for the full reference.

# Canonical, browser-facing URL of Nexus. This is also the OpenID Connect
# issuer, so it must be the URL clients actually reach.
NEXUS_ISSUER=http://localhost:3000
NEXUS_HOST=localhost:3000

# OpenID Connect ID token signing key (PEM). In development a throwaway key is
# generated at config/keys/oidc.pem on first boot if this is unset. In
# production this is required.
# NEXUS_OIDC_PRIVATE_KEY=

# SQLite database file.
DATABASE_PATH=storage/development.sqlite3

# Bootstrap admin user created by `bin/rails db:seed`.
NEXUS_ADMIN_EMAIL=admin@arcline.it
NEXUS_ADMIN_PASSWORD=password123
NEXUS_ADMIN_NAME=Nexus Admin

# "From" address for transactional email (password resets).
NEXUS_MAIL_FROM=Nexus <noreply@arcline.it>
